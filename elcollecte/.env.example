# ============================================
# Configuration Environment - eLcollecte
# ============================================

# Base de Données PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_PASSWORD=2005
DB_USER=postgres

# Kafka Configuration
KAFKA_SERVERS=kafka:29092
KAFKA_CLIENT_ID=elcollecte-app

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# MinIO Configuration
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# JWT & Security
JWT_SECRET=elcollecte-super-secret-key-2025-change-in-production-now
JWT_EXPIRATION_HOURS=24

# Service Discovery (Eureka)
EUREKA_HOST=service-discovery
EUREKA_PORT=8761
EUREKA_DEFAULT_ZONE=http://service-discovery:8761/eureka/

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application Profile
SPRING_PROFILES_ACTIVE=docker

# Database Names (optionnel)
DB_UTILISATEURS=elcollecte_users
DB_PROJETS=elcollecte_projets
DB_COLLECTES=elcollecte_collectes
DB_FORMULAIRES=elcollecte_formulaires_eies
DB_MEDIAS=elcollecte_medias
DB_VALIDATION=elcollecte_validation
DB_AUDIT=elcollecte_audit
DB_ANALYTIQUE=elcollecte_analytique
DB_RAPPORTS=elcollecte_rapports

# Mail Configuration (optionnel)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@elcollecte.org

# API External Services (optionnel)
API_TIMEOUT_MS=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_MS=1000

# Monitoring & Observability
ACTUATOR_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=false

# Application Settings
APP_NAME=eLcollecte
APP_VERSION=1.0.0-SNAPSHOT
APP_ENVIRONMENT=docker-development

